{
  "name": "hs-rag-classifier",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "runArgs": ["--gpus", "all"],
  "containerEnv": {
    "UV_PROJECT_ENVIRONMENT": "/home/vscode/.venv",
    "UV_LINK_MODE": "copy"
  },
  "postCreateCommand": "pip install --user uv && uv sync",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-azuretools.vscode-docker"],
      "settings": { "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python" }
    }
  }
}
